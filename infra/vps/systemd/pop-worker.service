[Unit]
Description=Prince of Pricing worker
After=network-online.target postgresql.service pop-api.service
Wants=network-online.target

[Service]
Type=simple
User=pop
Group=pop
WorkingDirectory=/srv/pop/current
EnvironmentFile=/etc/pop/pop.env
ExecStart=/usr/local/bin/node services/worker/dist/index.js
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/pop

[Install]
WantedBy=multi-user.target
