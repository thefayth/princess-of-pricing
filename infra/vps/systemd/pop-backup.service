[Unit]
Description=Encrypted Prince of Pricing PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/pop/pop.env
ExecStart=/usr/local/sbin/pop-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/pop
